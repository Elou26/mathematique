# Copie ce fichier en « .env » (jamais versionné) ou renseigne ces variables
# chez ton hébergeur. Voir LISEZMOI.md.

# La clé secrète Stripe. sk_test_… pour essayer, sk_live_… en production.
# Elle ne doit JAMAIS se retrouver dans abonnement.js ni dans la page.
STRIPE_CLE_SECRETE=sk_test_a_remplacer

# L'identifiant du tarif récurrent créé dans Stripe (Produits → Tarifs).
STRIPE_PRIX=price_a_remplacer

# Les adresses de l'app, séparées par des virgules. À remplir en production :
# elles limitent qui peut appeler ce serveur et où Stripe renvoie après paiement.
ORIGINES_AUTORISEES=http://localhost:8321

# Facultatif : le secret du webhook (Développeurs → Webhooks).
STRIPE_WEBHOOK_SECRET=

# ————— Lecture des photos (Mistral Document AI) —————————————————
# La clé API Mistral (console.mistral.ai). Comme celle de Stripe, elle ne
# doit JAMAIS se retrouver dans la page : la photo monte au serveur, repart
# chez Mistral, et seul le texte revient.
MISTRAL_CLE=

# Facultatif : le modèle et l'adresse, si tu veux en changer.
MISTRAL_MODELE=mistral-ocr-latest
MISTRAL_URL=https://api.mistral.ai/v1/ocr

# Garde-fous de facture : pages par appel, octets par appel, pages par heure
# et par appareil.
LECTURE_PAGES_MAX=4
LECTURE_PAGES_PAR_HEURE=40
