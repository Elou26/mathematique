# Copie ce fichier en « .env » (jamais versionné) ou renseigne ces variables
# chez ton hébergeur. Voir LISEZMOI.md.

# La clé secrète Stripe. sk_test_… pour essayer, sk_live_… en production.
# Elle ne doit JAMAIS se retrouver dans abonnement.js ni dans la page.
STRIPE_CLE_SECRETE=sk_test_a_remplacer

# Un tarif récurrent par offre (Produits → Tarifs). Les quotas et les prix
# affichés sont dans abonnement.js ; ici, seuls les identifiants Stripe.
STRIPE_PRIX_ESSENTIEL=price_a_remplacer     # 10 fiches/mois
STRIPE_PRIX_REGULIER=price_a_remplacer      # 30 fiches/mois
STRIPE_PRIX_INTENSIF=price_a_remplacer      # 60 fiches/mois

# Les mêmes offres payées à l'année (facultatif : sans elles, seul le mois
# est proposé). Même quota mensuel, une seule facture, trois mois offerts.
STRIPE_PRIX_ESSENTIEL_AN=
STRIPE_PRIX_REGULIER_AN=
STRIPE_PRIX_INTENSIF_AN=

# Les adresses de l'app, séparées par des virgules. À remplir en production :
# elles limitent qui peut appeler ce serveur et où Stripe renvoie après paiement.
ORIGINES_AUTORISEES=https://brainoko.com,https://www.brainoko.com,http://localhost:8321

# Facultatif : le secret du webhook (Développeurs → Webhooks).
STRIPE_WEBHOOK_SECRET=

# ————— Lecture des photos (Claude) —————————————————————————————
# La clé API Claude (console.anthropic.com). Comme celle de Stripe, elle ne
# doit JAMAIS se retrouver dans la page : les photos montent au serveur,
# partent chez Claude, et seule la fiche revient.
CLAUDE_CLE=

# Facultatif : le modèle et la profondeur de réflexion.
# claude-opus-5-5 est plus fin, pour environ deux fois le prix par fiche.
# CLAUDE_EFFORT=high aide sur un manuscrit ingrat — les paliers n'ont pas la
# même échelle d'un modèle à l'autre, à réessayer après un changement.
CLAUDE_MODELE=claude-sonnet-5-5
CLAUDE_EFFORT=medium

# Garde-fous de facture : pages par appel, octets par appel, pages par heure
# et par appareil.
LECTURE_PAGES_MAX=4
LECTURE_PAGES_PAR_HEURE=40

# ————— Les comptes (retrouver ses fiches sur un autre appareil) ————
# Tant que ces variables sont vides, les comptes restent éteints et l'app
# fonctionne comme avant : les fiches vivent dans le navigateur de l'élève.

# La base. Chez Supabase : Project Settings → API. BASE_CLE est la clé
# « service_role » — elle contourne toutes les protections, donc elle ne doit
# JAMAIS se retrouver dans une page ni dans le dépôt.
BASE_URL=
BASE_CLE=

# Le secret qui signe les sessions. Au moins 32 caractères au hasard :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# En changer déconnecte tout le monde (ce qui est parfois exactement le but).
SECRET_COMPTES=

# L'envoi des liens d'entrée. Un seul des deux suffit :
#   RESEND_CLE  si tu as un nom de domaine (meilleure délivrabilité) ;
#   BREVO_CLE   sinon, avec une adresse d'expéditeur vérifiée chez eux.
RESEND_CLE=
BREVO_CLE=
COURRIEL_EXPEDITEUR=Brainoko <bonjour@exemple.fr>

# L'adresse publique du site : c'est elle qui part dans le courriel.
SITE_URL=https://brainoko.com

# Entrer avec Google (facultatif). L'identifiant client est public : il part
# dans la page, c'est son rôle. Il n'y a pas de « client secret » à poser ici,
# le serveur ne fait que vérifier la signature du jeton rendu par Google.
# Vide = le bouton n'existe pas, et aucun élève n'est présenté à Google.
GOOGLE_CLIENT_ID=
